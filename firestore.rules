rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // TEMPORARY: Allow all read/write for development and seeding
    // TODO: Deploy proper security rules after seeding
    match /{document=**} {
      allow read, write: if true;
    }
    
